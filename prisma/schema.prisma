// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id
  username    String   @unique
  avatar      String?
  cover       String?
  name        String?
  surname     String?
  description String?
  city        String?
  school      String?
  work        String?
  website     String?
  createdAt   DateTime @default(now())

  // 帖子和评论
  posts    Post[]
  comments Comment[]

  // 点赞
  postLikes    PostLike[]
  commentLikes CommentLike[]

  // 分享
  shares Share[]

  // 被回复
  repliedComments Comment[] @relation("ReplyToUser")

  // 关注
  followers              Follower[]      @relation("UserFollowers")
  following              Follower[]      @relation("UserFollowings")
  followRequestsSent     FollowRequest[] @relation("FollowRequestsSend")
  followRequestsReceived FollowRequest[] @relation("FollowRequestsReceived")

  // 拉黑
  blocks   Block[] @relation("BlocksSent")
  blocksBy Block[] @relation("BlocksReceived")

  // Story
  story Story[]
}

// 帖子表
model Post {
  id        Int      @id @default(autoincrement())
  desc      String
  img       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 作者
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // 关联
  comments Comment[]
  likes    PostLike[]
  shares   Share[]

  // 计数（用于性能优化，避免每次count查询）
  likeCount    Int @default(0)
  commentCount Int @default(0)
  shareCount   Int @default(0)

  @@index([userId])
  @@index([createdAt])
}

// 评论表 - 支持无限层级嵌套
model Comment {
  id        Int      @id @default(autoincrement())
  desc      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 评论者
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // 所属帖子
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int

  // 父评论（直接上级）
  parentId Int?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  // 根评论（一级评论，方便查询整个评论树）
  rootId     Int?
  root       Comment?  @relation("RootComment", fields: [rootId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  allReplies Comment[] @relation("RootComment")

  // 被回复的用户（用于显示 "@xxx"）
  replyToUserId String?
  replyToUser   User?   @relation("ReplyToUser", fields: [replyToUserId], references: [id], onDelete: SetNull)

  // 点赞
  likes     CommentLike[]
  likeCount Int           @default(0)

  @@index([postId])
  @@index([parentId])
  @@index([rootId])
  @@index([userId])
}

// 帖子点赞表
model PostLike {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int

  @@unique([userId, postId])
  @@index([postId])
}

// 评论点赞表
model CommentLike {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId Int

  @@unique([userId, commentId])
  @@index([commentId])
}

// 分享表
model Share {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int

  platform String? // wechat / weibo / twitter / facebook / link

  @@index([postId])
  @@index([userId])
}

// 关注表
model Follower {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id])
  followerId  String
  following   User     @relation("UserFollowings", fields: [followingId], references: [id])
  followingId String

  @@unique([followerId, followingId])
}

// 关注请求表
model FollowRequest {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  sender     User     @relation("FollowRequestsSend", fields: [senderId], references: [id])
  senderId   String
  receiver   User     @relation("FollowRequestsReceived", fields: [receiverId], references: [id])
  receiverId String

  @@unique([senderId, receiverId])
}

// 拉黑表
model Block {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksSent", fields: [blockerId], references: [id])
  blockerId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id])
  blockedId String

  @@unique([blockerId, blockedId])
}

// Story表
model Story {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  img       String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
}
